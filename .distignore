# The compiled block bundle ships in assets/js/build/, so assets/js/src/ ships
# with it, and so do package.json and webpack.config.js, the tools that build
# one from the other. WordPress.org requires human-readable source and its
# build tools alongside compiled or minified code; excluding them is a routine
# review rejection.
/.git
/.github
/.qodo
/archs
/node_modules
/vendor
/tests
/research_notes
/reports
.distignore
.wp-env.json
.wp-env.override.json
.eslintrc.js
.gitignore
composer.json
composer.lock
package-lock.json
phpcs.xml.dist
phpunit.xml.dist
.phpunit.result.cache
README.md
