<?xml version="1.0"?>
<ruleset name="Afriex Gateway for WooCommerce">
	<description>WordPress coding standards for the Afriex WooCommerce gateway.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/js/build/*</exclude-pattern>
	<exclude-pattern>/archs/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- The plugin targets PHP 7.4+, where short array syntax is fine, but
		     WPCS still prefers long arrays for consistency with WooCommerce
		     core. Keeping the default. -->
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="afriex-gateway-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="afriex"/>
				<element value="AFRIEX_WC"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce registers this capability. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!-- WooCommerce's own naming for abstract classes (abstract-wc-*.php), and
	     mu-plugins, which WordPress loads by file name, not by class. -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>/includes/abstract-*.php</exclude-pattern>
		<exclude-pattern>/tests/mu-plugins/*</exclude-pattern>
	</rule>

	<!-- PHPUnit tests. A test method's name is its sentence, and a data
	     provider has nothing to say about its cases that the case names do not
	     say better. The bootstrap defines ABSPATH and ARRAY_A because the
	     classes under test check for them; both are WordPress's own names,
	     which is the whole point of defining them. -->
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
		<exclude-pattern>/tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.DocComment.MissingShort">
		<exclude-pattern>/tests/unit/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>/tests/unit/bootstrap.php</exclude-pattern>
	</rule>

	<config name="minimum_wp_version" value="6.0"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>
