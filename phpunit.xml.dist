<?xml version="1.0" encoding="UTF-8"?>
<!--
	Unit tests for the plugin's pure classes. They run without WordPress:
	tests/unit/bootstrap.php defines ABSPATH and the few stubs the classes need.
	Run inside the wp-env container, as the Apache user, from the plugin folder:
		vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/unit/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	failOnRisky="true"
	failOnWarning="true"
	cacheResult="false">
	<testsuites>
		<testsuite name="unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<php>
		<ini name="error_reporting" value="-1"/>
		<ini name="display_errors" value="1"/>
	</php>
</phpunit>
